{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "incremental": true,
    "paths": {
      "@shelfcure/ui": ["./packages/ui/src/index.ts"],
      "@shelfcure/ui/*": ["./packages/ui/src/*"],
      "@shelfcure/core": ["./packages/core/src/index.ts"],
      "@shelfcure/core/*": ["./packages/core/src/*"],
      "@shelfcure/db-types": ["./packages/db-types/src/index.ts"],
      "@shelfcure/api-client": ["./packages/api-client/src/index.ts"],
      "@shelfcure/api-client/*": ["./packages/api-client/src/*"],
      "@shelfcure/sync-engine": ["./packages/sync-engine/src/index.ts"],
      "@shelfcure/sync-engine/*": ["./packages/sync-engine/src/*"],
      "@shelfcure/hotkeys": ["./packages/hotkeys/src/index.ts"],
      "@shelfcure/hotkeys/*": ["./packages/hotkeys/src/*"],
      "@shelfcure/i18n": ["./packages/i18n/src/index.ts"],
      "@shelfcure/i18n/*": ["./packages/i18n/src/*"],
      "@shelfcure/config": ["./packages/config/src/index.ts"],
      "@shelfcure/config/*": ["./packages/config/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo", "src-tauri/target"]
}
