# ShelfCure Cloud — environment template
# Copy to .env.local and fill in actual values. .env.local is gitignored.
# The service_role key NEVER goes in any committed file or in any client app.
# It only lives in: (a) your local .env.local, (b) GitHub Actions encrypted secrets, (c) Supabase Edge Function secrets.

# ───── Public (safe to ship in client bundles) ─────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───── Server-side only (never imported by web/desktop/mobile clients) ─────
# Used by: Supabase Edge Functions, migration scripts, admin/maintenance tools.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # PASTE LOCALLY ONLY. Rotate if leaked.

# ───── Razorpay (Phase 6) ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───── Gemini (Phase 7 — AI bill scan) ─────
GEMINI_API_KEY=

# ───── WhatsApp Business API (Phase 7) ─────
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ───── GSTN e-Invoice (Phase 7) ─────
GSTN_CLIENT_ID=
GSTN_CLIENT_SECRET=

# ───── Sentry (all phases) ─────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ───── Resend / email (Phase 3 — invitation emails, receipts) ─────
RESEND_API_KEY=
